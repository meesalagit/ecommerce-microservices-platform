# Copy this file to .env and fill in real values. .env is git-ignored.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Must be at least 32 characters (HMAC-SHA256). Same value for every service.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Shared key that order-service sends to inventory-service
INTERNAL_SERVICE_KEY=replace-with-a-random-internal-key
